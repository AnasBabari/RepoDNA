{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoDNAProject",
  "description": "Canonical schema for RepoDNA deterministic codebase analysis artifacts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "technologies",
    "files",
    "symbols",
    "imports",
    "calls",
    "routes",
    "databases",
    "entrypoints",
    "flows",
    "architecture",
    "metrics",
    "diagnostics",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Semantic version of the RepoDNA output contract."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the analysis was generated."
    },
    "repository": {
      "type": "object",
      "required": ["name", "source", "languages", "fileCount", "sourceFileCount", "parsedFileCount", "lines", "fingerprint"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "languages": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "fileCount": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 },
        "parsedFileCount": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "object",
          "required": ["languages", "frameworks", "infrastructure", "databases", "externalSystems", "testing", "buildTools"],
          "properties": {
            "languages": { "type": "array", "items": { "type": "string" } },
            "frameworks": { "type": "array", "items": { "type": "string" } },
            "infrastructure": { "type": "array", "items": { "type": "string" } },
            "databases": { "type": "array", "items": { "type": "string" } },
            "externalSystems": { "type": "array", "items": { "type": "string" } },
            "testing": { "type": "array", "items": { "type": "string" } },
            "buildTools": { "type": "array", "items": { "type": "string" } },
            "tooling": { "type": "array", "items": { "type": "string" } },
            "languageFileCounts": {
              "type": "object",
              "additionalProperties": { "type": "integer" }
            }
          }
        }
      }
    },
    "technologies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "language", "lines", "bytes", "hash", "role", "parsed"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "language": { "type": "string" },
          "lines": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string" },
          "role": { "type": "string" },
          "parsed": { "type": "boolean" },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "file", "line", "exported", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "endLine": { "type": ["integer", "null"] },
          "end_line": { "type": ["integer", "null"] },
          "parent": { "type": ["string", "null"] },
          "exported": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "module", "names", "line", "external"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "module": { "type": "string" },
          "names": { "type": "array", "items": { "type": "string" } },
          "line": { "type": "integer", "minimum": 1 },
          "target": { "type": ["string", "null"] },
          "external": { "type": "boolean" }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "callee", "file", "line", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "callee": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "target": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "resolutionType": { "type": "string" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "handler", "file", "line", "framework", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "handler": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "framework": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "confidence", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "externalSystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "confidence", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "external_systems": {
      "type": "array",
      "items": { "type": "object" }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "kind", "score", "confidence", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "kind": { "type": "string" },
          "score": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "confidence", "nodes", "edges"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "label", "file", "line"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "label": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "target", "type"],
              "properties": {
                "source": { "type": "string" },
                "target": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["components", "connections"],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type", "files", "confidence", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" },
              "files": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "target", "type", "weight"],
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "target": { "type": "string" },
              "type": { "type": "string" },
              "weight": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "importantFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "score", "reasons"],
        "properties": {
          "file": { "type": "string" },
          "score": { "type": "number" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "important_files": {
      "type": "array",
      "items": { "type": "object" }
    },
    "onboarding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "title", "file", "description"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "complexityScore",
        "localDependencies",
        "externalDependencies",
        "dependencyCycles",
        "mostConnectedFiles",
        "highCouplingFiles",
        "symbols",
        "routes",
        "components",
        "parseSuccessRate"
      ],
      "properties": {
        "complexityScore": { "type": "number" },
        "localDependencies": { "type": "integer", "minimum": 0 },
        "externalDependencies": { "type": "integer", "minimum": 0 },
        "dependencyCycles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "mostConnectedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "connections"],
            "properties": {
              "file": { "type": "string" },
              "connections": { "type": "integer" }
            }
          }
        },
        "highCouplingFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "connections"],
            "properties": {
              "file": { "type": "string" },
              "connections": { "type": "integer" }
            }
          }
        },
        "symbols": { "type": "integer", "minimum": 0 },
        "routes": { "type": "integer", "minimum": 0 },
        "components": { "type": "integer", "minimum": 0 },
        "parseSuccessRate": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["analysisMode", "executedRepositoryCode"],
      "properties": {
        "analysisMode": { "type": "string" },
        "executedRepositoryCode": { "type": "boolean" },
        "analyzerVersion": { "type": "string" },
        "limits": { "type": "object" },
        "fileComponents": { "type": "object" },
        "cache": { "type": "object" }
      }
    }
  }
}
