{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoDNAProject",
  "description": "Canonical schema for RepoDNA deterministic codebase analysis artifacts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "technologies",
    "files",
    "symbols",
    "imports",
    "calls",
    "routes",
    "databases",
    "entrypoints",
    "flows",
    "architecture",
    "metrics",
    "diagnostics",
    "metadata"
  ],
  "definitions": {
    "manifestInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "packages", "declarations", "problems"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable"] },
        "packages": { "type": "array", "maxItems": 2000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["ecosystem", "root", "name", "workspace", "manifests"],
          "properties": {
            "ecosystem": { "enum": ["npm", "python", "go"] }, "root": { "type": "string", "maxLength": 4096 },
            "name": { "type": ["string", "null"], "maxLength": 512 }, "workspace": { "type": "boolean" },
            "manifests": { "type": "array", "maxItems": 2000, "items": { "type": "string", "maxLength": 4096 } }
          }
        } },
        "declarations": { "type": "array", "maxItems": 50000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["ecosystem", "root", "name", "scope", "group", "file"],
          "properties": {
            "ecosystem": { "enum": ["npm", "python", "go"] }, "root": { "type": "string", "maxLength": 4096 },
            "name": { "type": "string", "maxLength": 512 },
            "scope": { "enum": ["runtime", "development", "optional", "peer", "build", "unspecified"] },
            "group": { "type": "string", "maxLength": 1024 }, "file": { "type": "string", "maxLength": 4096 }
          }
        } },
        "problems": { "type": "array", "maxItems": 2000, "items": {
          "type": "object", "additionalProperties": false, "required": ["file", "code", "message"],
          "properties": { "file": { "type": "string", "maxLength": 4096 }, "code": { "type": "string", "maxLength": 128 }, "message": { "type": "string", "maxLength": 1024 } }
        } }
      }
    },
    "sourceInventory": {
      "description": "Classification of observed paths only; acquisition truncation remains authoritative.",
      "type": "object", "additionalProperties": false,
      "required": ["classificationVersion", "totalFileCount", "firstPartySourceFileCount", "supportedSourceFileCount", "unsupportedSourceFileCount", "evidenceFileCount", "otherFileCount", "ignoredFileCount", "generatedFileCount", "candidateFileCount", "skippedSupportedSourceFileCount"],
      "properties": {
        "classificationVersion": { "const": 2 },
        "totalFileCount": { "type": "integer", "minimum": 0 }, "firstPartySourceFileCount": { "type": "integer", "minimum": 0 },
        "supportedSourceFileCount": { "type": "integer", "minimum": 0 }, "unsupportedSourceFileCount": { "type": "integer", "minimum": 0 },
        "evidenceFileCount": { "type": "integer", "minimum": 0 }, "otherFileCount": { "type": "integer", "minimum": 0 },
        "ignoredFileCount": { "type": "integer", "minimum": 0 }, "generatedFileCount": { "type": "integer", "minimum": 0 },
        "candidateFileCount": { "type": "integer", "minimum": 0 }, "skippedSupportedSourceFileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceOutcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["supported", "complete", "partial", "failed", "skipped", "unprocessed"],
      "properties": {
        "supported": { "type": "integer", "minimum": 0 }, "complete": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }, "unprocessed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0",
      "description": "Semantic version of the RepoDNA output contract."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the analysis was generated."
    },
    "repository": {
      "type": "object",
      "required": ["name", "source", "languages", "fileCount", "sourceFileCount", "parsedFileCount", "lines", "fingerprint"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "languages": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "fileCount": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 },
        "parsedFileCount": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "object",
          "required": ["languages", "frameworks", "infrastructure", "databases", "externalSystems", "testing", "buildTools"],
          "properties": {
            "languages": { "type": "array", "items": { "type": "string" } },
            "frameworks": { "type": "array", "items": { "type": "string" } },
            "infrastructure": { "type": "array", "items": { "type": "string" } },
            "databases": { "type": "array", "items": { "type": "string" } },
            "externalSystems": { "type": "array", "items": { "type": "string" } },
            "testing": { "type": "array", "items": { "type": "string" } },
            "buildTools": { "type": "array", "items": { "type": "string" } },
            "tooling": { "type": "array", "items": { "type": "string" } },
            "languageFileCounts": {
              "type": "object",
              "additionalProperties": { "type": "integer" }
            }
          }
        }
      }
    },
    "technologies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "language", "lines", "bytes", "hash", "role", "parsed"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "language": { "type": "string" },
          "lines": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string" },
          "role": { "type": "string" },
          "parsed": { "type": "boolean" },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "file", "line", "exported", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "endLine": { "type": ["integer", "null"] },
          "end_line": { "type": ["integer", "null"] },
          "parent": { "type": ["string", "null"] },
          "exported": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "module", "names", "line", "external"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "module": { "type": "string" },
          "names": { "type": "array", "items": { "type": "string" } },
          "line": { "type": "integer", "minimum": 1 },
          "target": { "type": ["string", "null"] },
          "external": { "type": "boolean" }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "callee", "file", "line", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "callee": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "target": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "resolutionType": { "type": "string" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "method", "path", "handler", "file", "line", "framework", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "handler": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "framework": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "confidence", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "externalSystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "confidence", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "external_systems": {
      "type": "array",
      "items": { "type": "object" }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "kind", "score", "confidence", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "kind": { "type": "string" },
          "score": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "confidence", "nodes", "edges"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "label", "file", "line"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "label": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "target", "type"],
              "properties": {
                "source": { "type": "string" },
                "target": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["components", "connections"],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type", "files", "confidence", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" },
              "files": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "target", "type", "weight"],
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "target": { "type": "string" },
              "type": { "type": "string" },
              "weight": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "importantFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "score", "reasons"],
        "properties": {
          "file": { "type": "string" },
          "score": { "type": "number" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "important_files": {
      "type": "array",
      "items": { "type": "object" }
    },
    "onboarding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "title", "file", "description"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "complexityScore",
        "localDependencies",
        "externalDependencies",
        "dependencyCycles",
        "mostConnectedFiles",
        "highCouplingFiles",
        "symbols",
        "routes",
        "components",
        "parseSuccessRate"
      ],
      "properties": {
        "complexityScore": { "type": "number" },
        "localDependencies": { "type": "integer", "minimum": 0 },
        "externalDependencies": { "type": "integer", "minimum": 0 },
        "dependencyCycles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "mostConnectedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "connections"],
            "properties": {
              "file": { "type": "string" },
              "connections": { "type": "integer" }
            }
          }
        },
        "highCouplingFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "connections"],
            "properties": {
              "file": { "type": "string" },
              "connections": { "type": "integer" }
            }
          }
        },
        "symbols": { "type": "integer", "minimum": 0 },
        "routes": { "type": "integer", "minimum": 0 },
        "components": { "type": "integer", "minimum": 0 },
        "parseSuccessRate": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["analysisMode", "executedRepositoryCode"],
      "properties": {
        "manifestInventory": { "$ref": "#/definitions/manifestInventory" },
        "sourceInventory": { "$ref": "#/definitions/sourceInventory" },
        "sourceOutcomes": { "$ref": "#/definitions/sourceOutcomes" },
        "extractionLimits": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "category",
              "limit",
              "omittedCount",
              "countIsLowerBound",
              "range"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "symbols",
                  "imports",
                  "calls",
                  "ast_nodes",
                  "ast_depth"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              },
              "omittedCount": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "countIsLowerBound": {
                "type": "boolean"
              },
              "range": {
                "type": "object",
                "required": [
                  "startLine",
                  "endLine",
                  "startColumn",
                  "endColumn"
                ],
                "additionalProperties": false,
                "properties": {
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "startColumn": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "endColumn": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "analysisMode": { "type": "string" },
        "executedRepositoryCode": { "type": "boolean" },
        "analyzerVersion": { "type": "string" },
        "limits": { "type": "object" },
        "fileComponents": { "type": "object" },
        "cache": { "type": "object" }
      }
    }
  }
}
