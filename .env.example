# ==============================================================================
# RepoDNA V1.1 — Environment Variables Template
# ==============================================================================

# Auth.js / NextAuth (Generate with: openssl rand -base64 32)
AUTH_SECRET=""
# For local dev: http://localhost:3000 | For production: https://repodna-one.vercel.app
AUTH_URL="http://localhost:3000"

# GitHub OAuth Application Credentials (legacy fallback)
# GitHub Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Callback URL: <YOUR_DOMAIN>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# GitHub App — Least-Privilege Private Repository Access (ADR 004)
# Create at: GitHub Settings -> Developer Settings -> GitHub Apps -> New GitHub App
# Permissions: contents:read, metadata:read (read-only)
# Callback URL: <YOUR_DOMAIN>/api/auth/callback/github
# When GITHUB_APP_ID + GITHUB_APP_PRIVATE_KEY are set, RepoDNA uses GitHub App OAuth
# (fine-grained, per-repo install, short-lived installation tokens). Otherwise it falls
# back to the OAuth App above. See docs/adr/004-github-app-least-privilege-private-access.md
# GITHUB_APP_ID=""                 # numeric App ID (e.g. 1234567)
# GITHUB_APP_PRIVATE_KEY=""        # PEM private key (single line with \n or base64); RS256 JWT 10m expiry
# GITHUB_APP_CLIENT_ID=""          # GitHub App OAuth client ID (Iv1.xxxxx)
# GITHUB_APP_CLIENT_SECRET=""      # GitHub App OAuth client secret
# GITHUB_AUTH_MODE=""              # optional override: "github-app" | "oauth" (default: auto-detect)

# PostHog EU Privacy-Safe Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Upstash Redis (Rate Limiter)
# Console: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Vercel Blob — private store for public analysis artifacts + derived graph exports
# Provisioned automatically on Vercel (`vercel env pull`), or set BLOB_READ_WRITE_TOKEN locally.
# Public exports are cached for 7 days at repodna/public/<owner>/<repo>/<commit>/.../exports/1.0.0/<digest>/expires-<epoch>/
# BLOB_READ_WRITE_TOKEN=""

# Cron — daily cleanup of expired public artifacts and derived exports (Vercel Hobby: once daily)
# Generate with: openssl rand -base64 32
# CRON_SECRET=""

# Graph Exports — Parquet is a stretch feature, disabled until JSON/CSV/Cypher are green in prod
# NEXT_PUBLIC_REPODNA_PARQUET_EXPORT="false"
